{
  "schema": "thistinti.procurement-evaluation-protocol.v1",
  "protocol_id": "procurement-blind-evaluation-v1",
  "version": "1",
  "status": "pilot-baseline",
  "sample": {
    "calibration_min": 5,
    "calibration_max": 10,
    "blind_min": 20,
    "blind_max": 25,
    "similarity_leakage_forbidden": true
  },
  "freeze": {
    "software": true,
    "practice_model": true,
    "rule_pack": true,
    "company_profile": true,
    "ground_truth_protocol": true,
    "evaluation_protocol": true,
    "case_register": true
  },
  "reporting": {
    "raw_counts_before_percentages": true,
    "uncertainty_intervals": "Wilson 95% for precision and recall where denominators exist",
    "results_by_case_type": true,
    "critical_misses": true,
    "economic_metrics": true,
    "small_sample_generalization_forbidden": true
  },
  "economic_semantics": {
    "potential_exposure_is_not_confirmed_loss": true,
    "cross_currency_aggregation_forbidden": true
  },
  "change_control": {
    "blind_run_changes_allowed": false,
    "any_frozen_change_requires_new_manifest": true,
    "results_from_different_manifests_must_not_be_pooled_as_one_run": true
  },
  "error_handling": {
    "blind_errors_feed_next_version_backlog": true,
    "blind_errors_are_not_fixed_in_place": true
  }
}
